{
  "name": "myrecord",
  "productName": "MyRecord",
  "version": "1.0.0",
  "description": "MyRecord — a drag-and-drop beat maker. Apply, then customize.",
  "main": "main.js",
  "author": "qub-official",
  "license": "MIT",
  "homepage": "https://qub-official.github.io/myrecord/",
  "repository": {
    "type": "git",
    "url": "https://github.com/qub-official/myrecord.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.myrecord.beatstudio",
    "productName": "MyRecord",
    "copyright": "MyRecord",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "MyRecord-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyRecord",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "mrec",
        "name": "MyRecord Project",
        "description": "MyRecord beat project"
      }
    ]
  }
}
